{
  "omg-orchestrator-guard": {
    "PreToolUse": [
      {
        "matcher": "swarm|invoke_subagent|manage_subagents",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hook-guard.mjs pre-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/hook-guard.mjs stop",
        "timeout": 10
      }
    ]
  }
}
